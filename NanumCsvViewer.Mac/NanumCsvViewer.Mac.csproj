<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos26.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>kr.nanumspace.csvviewer</ApplicationId>
    <ApplicationTitle>Nanum CSV Viewer</ApplicationTitle>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NanumCsvViewer.Core\NanumCsvViewer.Core.csproj" />
    <PackageReference Include="Eto.Forms" Version="2.12.0" />
    <PackageReference Include="Eto.Platform.macOS" Version="2.12.0" />
    <Compile Include="..\NanumCsvViewer.Eto\ViewerForm.cs" Link="ViewerForm.cs" />
  </ItemGroup>
</Project>
