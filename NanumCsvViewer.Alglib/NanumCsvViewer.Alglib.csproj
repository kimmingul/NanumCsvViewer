<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ALGLIB Commercial(순수 C#) 소스를 별도 어셈블리로 컴파일한다(이슈 #27).
    소스는 라이선스상 공개 저장소에 둘 수 없어 .gitignore 된 ExternalLibs/ALGLIB 에 로컬로만 둔다.
    단일 파일 게시(PublishSingleFile)에서 이 DLL은 exe 안에 번들되므로 배포 파일은 늘지 않는다.
    네이티브 HPC 코어(native-core-wrappers, alglib404hpc_*.dll)는 쓰지 않는다 — 순수 관리형만.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NanumCsvViewer.Alglib</AssemblyName>
    <RootNamespace>alglib</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- ALGLIB 커널이 SIMD(Sse2/Avx2/Fma) 경로에서 unsafe 포인터를 쓴다. IsSupported로 분기하므로 arm64도 안전. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);ALGLIB_USE_SIMD</DefineConstants>
    <!-- 벤더 소스는 수정하지 않으므로 경고를 앱 빌드 출력에 섞지 않는다. -->
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS1591;CS8981;SYSLIB0011;SYSLIB0051</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- alglib_info.cs가 Company/Product/InformationalVersion 어셈블리 특성을 직접 선언한다. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <AlglibSourceDir>$(MSBuildThisFileDirectory)..\ExternalLibs\ALGLIB\alglib-csharp\lib-csharp-core\src\</AlglibSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(AlglibSourceDir)*.cs" />
  </ItemGroup>

  <Target Name="RequireAlglibSource" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(AlglibSourceDir)ap.cs')"
           Text="ALGLIB Commercial C# 소스가 없습니다: $(AlglibSourceDir) — 라이선스 보유 배포본을 ExternalLibs\ALGLIB 에 풀어 주세요(저장소에는 커밋하지 않음)." />
  </Target>

</Project>
