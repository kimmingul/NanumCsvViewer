<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Per-Monitor V2: WebView2(msedgewebview2.exe)와 같은 DPI 모드. System aware이면 msedgewebview2.exe에 HIGHDPIAWARE 호환성 레이어가 걸린 PC에서 0x8007139F로 채팅이 시작되지 않았다(WebViewInitTests가 이 설정을 확인). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 2GB가 넘는 파일을 안전하게 메모리 매핑/버퍼링하려면 64비트 프로세스가 필요합니다. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64;AnyCPU</Platforms>

    <!-- 어셈블리/실행 파일 메타데이터(About 창·파일 속성에 노출) -->
    <Product>Nanum CSV Viewer</Product>
    <AssemblyTitle>Nanum CSV Viewer</AssemblyTitle>
    <Description>대용량 CSV를 빠르게 열고 탐색하는 Windows 데스크톱 뷰어.</Description>
    <Version>3.4.3</Version>
    <FileVersion>3.4.3.0</FileVersion>
    <AssemblyVersion>3.4.3.0</AssemblyVersion>
    <!-- 릴리즈 날짜: release.ps1이 publish 시 -p:ReleaseDate로 주입. 미지정(dev 빌드)이면 빌드일. -->
    <ReleaseDate Condition="'$(ReleaseDate)' == ''">$([System.DateTime]::Now.ToString("yyyy-MM-dd"))</ReleaseDate>
    <!-- Microsoft.Web.WebView2는 WinForms 프로젝트에도 Wpf.dll 참조를 가져와 WindowsBase 버전 충돌 경고(MSB3277)가 난다. 동작에는 영향 없음. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- WebView2 NuGet의 XML 문서 파일(~0.8MB)이 publish 출력·단일 exe에 섞이지 않게 한다. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Curiosity.SPSS" Version="1.3.2" />
    <!-- v3 작업 공간 질의 엔진(DuckDB, 프로세스 내장). win-x64·win-arm64 네이티브 duckdb.dll 포함(~37/43MB). -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="SasReader" Version="1.0.6" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- ALGLIB Commercial(순수 C#, 이슈 #27). 소스는 로컬 전용 ExternalLibs/ALGLIB — 단일 exe에 번들된다. -->
    <ProjectReference Include="..\NanumCsvViewer.Alglib\NanumCsvViewer.Alglib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- v2 에이전트 채팅 페이지(RAD Agent에서 이식, MIT). exe에 내장했다가 %LOCALAPPDATA%\NanumCsvViewer\chat\<버전+해시>로 풀어 WebView2에 매핑한다. -->
    <EmbeddedResource Include="Agent\ChatAssets\**\*" LogicalName="ChatAssets/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <!-- omp append-system-prompt용 에이전트 가이드(OmpProcess가 이름 끝 "AgentGuide.md"로 찾아 읽는다). -->
    <EmbeddedResource Include="Agent\AgentGuide.md" Condition="Exists('Agent\AgentGuide.md')" />
    <!-- 분석 스킬 묶음(K-Dense scientific-agent-skills MIT + 앱 전용 nanum-python-analysis). %LOCALAPPDATA%\NanumCsvViewer\skills\<해시>\로 풀어 omp skills.customDirectories에 건다. -->
    <EmbeddedResource Include="Agent\Skills\**\*" LogicalName="Skills/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <!-- Python 분석 환경 요구사항 묶음(core·stats·clinical·ml). 정확한 버전 고정, AnalysisGroups가 읽는다. -->
    <EmbeddedResource Include="Agent\Python\requirements\*.txt" LogicalName="requirements/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 정보 창이 AppInfo.ReleaseDate로 읽는다. -->
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
    <!-- 테스트가 내부 헬퍼(예: SpssHeaderName)를 직접 검증할 수 있게 노출. -->
    <InternalsVisibleTo Include="NanumCsvViewer.Tests" />
  </ItemGroup>

  <!--
    .NET 10부터 System.Text.Encoding.CodePages가 런타임에 포함되어 별도 PackageReference가 필요 없습니다.
    CP949/EUC-KR(코드페이지 949)은 Program.cs의 RegisterProvider(CodePagesEncodingProvider.Instance)로 활성화됩니다.
  -->

</Project>
